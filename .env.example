# Copy this file to .env.local and fill in the values.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret key (service_role / secret). Server-only — used ONLY by the admin
# Users page to create accounts, reset passwords and disable users.
# Never prefix it with NEXT_PUBLIC_ and never share it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public site URL (used in sign-up confirmation emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store details
NEXT_PUBLIC_CURRENCY=MVR

# Bank transfer details shown to customers on their order page
BANK_NAME=Bank of Maldives
BANK_ACCOUNT_NAME=Your Company Pvt Ltd
BANK_ACCOUNT_NUMBER=7700000000000
